{
  "name": "comp7610-weather-market",
  "version": "0.1.0",
  "private": true,
  "description": "Rain or Shine: Hong Kong weather prediction markets on Sepolia, settled through UMA Optimistic Oracle V3",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "compile": "hardhat build",
    "test:contracts": "hardhat test mocha",
    "node:local": "hardhat node",
    "export": "npm run export:metric",
    "deploy:local": "npm run deploy:metric:local",
    "local:advance": "tsx scripts/advance-time.ts",
    "test:web": "tsx scripts/ensure-generated.ts && vitest run --config web/vite.config.ts --reporter=verbose",
    "lint": "eslint .",
    "build": "hardhat build --build-profile production && tsx scripts/export-metric-deployment.ts && npm run build -w web",
    "typecheck": "hardhat build && tsx scripts/ensure-generated.ts && tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "dev": "npm run export:metric && npm run dev:local -w web",
    "dev:local": "npm run dev",
    "test:shared": "vitest run --reporter=verbose",
    "test:launcher": "vitest run --reporter=verbose test/launcher",
    "weather:data": "tsx scripts/weather-data.ts",
    "test:weather": "vitest run --reporter=verbose test/weather",
    "typecheck:weather": "tsc -p tsconfig.weather.json --noEmit",
    "export:metric": "hardhat build && tsx scripts/export-metric-deployment.ts",
    "deploy:metric:local": "hardhat run --network localhost scripts/deploy-metric-local.ts && npm run export:metric",
    "seed:metric:local": "hardhat run --network localhost scripts/seed-metric-local.ts",
    "preflight:metric:sepolia": "tsx scripts/preflight-metric-sepolia.ts",
    "deploy:metric:sepolia": "hardhat run --network sepolia --build-profile production scripts/deploy-metric-sepolia.ts && npm run export:metric",
    "verify:metric:sepolia": "hardhat build --build-profile production && tsx scripts/verify-metric-sepolia.ts",
    "test:fork": "hardhat --config hardhat.fork.config.ts test mocha",
    "dev:metric:sepolia": "npm run export:metric && npm run dev:sepolia -w web",
    "build:metric:sepolia": "hardhat build --build-profile production && tsx scripts/export-metric-deployment.ts && npm run build:sepolia -w web",
    "dev:metric": "npm run dev",
    "build:metric": "npm run build",
    "test:metric:data": "vitest run test/metric",
    "package:desktop": "npm run verify:metric:sepolia && tsx scripts/package-desktop.ts",
    "weather:collect": "tsx scripts/get-weather-evidence.ts",
    "build:weather:portable": "tsx scripts/build-portable-weather.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.63.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "chai": "6.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "hardhat": "3.18.1",
    "mocha": "12.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.1"
  }
}
