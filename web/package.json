{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local-chain",
    "dev:sepolia": "vite --mode sepolia",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
