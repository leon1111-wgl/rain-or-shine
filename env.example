# Only needed to deploy your own copy. Set these in your terminal. Nothing loads this file.
# Never commit a filled key.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The browser sees this value. Use a public endpoint.
SEPOLIA_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The deployer's public address. Deployment refuses any other signer.
SEPOLIA_CHECK_ADDRESS=

# Better: npx hardhat keystore set SEPOLIA_DEPLOYER_KEY
SEPOLIA_DEPLOYER_KEY=
# Set this to sepolia to allow deployment.
DEPLOY_CONFIRM=

# Bond amounts, in units of the bond token.
SEPOLIA_POLICY_BOND=1
SEPOLIA_MAX_BOND=10

# Spending caps for the deployment.
MAX_FEE_GWEI=20
MAX_DEPLOY_COST_ETH=0.05
