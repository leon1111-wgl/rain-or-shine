# Reference values only. Hardhat reads process environment/config variables;
# this file is not automatically loaded. Never commit a filled private key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# This separate URL is exported to the browser. Use a genuinely public endpoint.
SEPOLIA_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# PUBLIC address: optional for read-only preflight; required for deployment.
# Deployment refuses a signing account different from this expected administrator.
SEPOLIA_CHECK_ADDRESS=

# Prefer encrypted local storage: npx hardhat keystore set SEPOLIA_DEPLOYER_KEY
# Hardhat configVariable resolves this key from its keystore or process environment.
# Set only in your private terminal/key store for a reviewed testnet deployment.
SEPOLIA_DEPLOYER_KEY=
# Broadcast remains disabled unless this exact variable is set to sepolia.
DEPLOY_CONFIRM=

# Human-readable amounts in the selected test token's units.
SEPOLIA_POLICY_BOND=1
SEPOLIA_MAX_BOND=10

# Maximum transaction fee rate and conservative total cost across three gas caps.
MAX_FEE_GWEI=20
MAX_DEPLOY_COST_ETH=0.05
